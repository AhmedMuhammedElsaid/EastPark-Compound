# EAS Build upload rules for the mobile app (apps/mobile).
#
# eas-cli reads .easignore ONLY from the git root, and when it exists it
# REPLACES every .gitignore in the repo (root, apps/*, nested ones). Any secret
# rule added to a .gitignore must therefore be repeated here.
#
# Every rule is written root-relative (or as a bare name) on purpose: under the
# .gitignore fallback, eas-cli on Windows applied only the ROOT .gitignore and
# skipped the nested apps/*/.gitignore files, so apps/web/.next, coverage and
# .expo were uploaded. Rules here must not rely on any nested ignore file.
#
# The other workspace apps stay in the upload (only their build output is
# dropped): the root pnpm-lock.yaml lists them as importers, so EAS's frozen
# install needs their package.json files.
#
# Verify after any change, without starting a build:
#   cd apps/mobile && eas build:inspect --platform android --stage archive --profile preview --output <empty dir>

# Secrets and local environment (every app)
.env
.env.*
!.env.example
!.env.docker
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.deploy-secrets
.fly-token
/apps/backend/config.yaml
/apps/backend/config.yml
.vercel

# Database dumps and exports
*.dump
*.sql.gz

# Dependencies and build/test output
node_modules
.pnp.*
.next
/apps/web/out
/apps/web/build
/apps/web/next-env.d.ts
dist
coverage
*.tsbuildinfo
.expo
web-build
.astro
/apps/backend/tmp
/apps/backend/temp
.yalc
yalc.lock
.husky/_

# Native folders are generated by prebuild on EAS
/apps/mobile/ios
/apps/mobile/android

# Build artifacts
*.apk
*.aab
*.ipa

# Logs and OS files
npm-debug.*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.orig.*
.DS_Store

# Editor and agent tooling
.idea
.vscode
.claude
.agents
.kilo
skills-lock.json

# Not used by the mobile build
/eastpark-backend
/eastpark-web-app
/eastpark-frontend
/apps/mobile/docs
/apps/mobile/Documentation
