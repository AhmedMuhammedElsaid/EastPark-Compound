{
  "name": "eastpark-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check:shared": "pnpm --filter @eastpark/shared typecheck && pnpm --filter @eastpark/shared test",
    "check:web": "pnpm --dir eastpark-web-app exec tsc --noEmit",
    "check:mobile": "pnpm --dir eastpark-frontend type-check",
    "check:backend": "pnpm --dir eastpark-backend typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react-native-worklets": "0.5.1"
    }
  }
}
