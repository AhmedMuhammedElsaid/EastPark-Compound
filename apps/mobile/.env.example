# EastPark Frontend — Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local is git-ignored and takes precedence over .env.
# NEVER commit real secrets to .env or any tracked file.

# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# API Configuration — your backend URL (do NOT add /v1, the Axios client appends it)
# For Android emulator use http://10.0.2.2:3000
# For physical device use your machine's LAN IP, e.g. http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# PostHog analytics key (optional — leave blank for local dev)
EXPO_PUBLIC_POSTHOG_KEY=

# Example variables (used by env.ts Zod validation)
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

# Build-time only secrets (no EXPO_PUBLIC prefix — NOT accessible in client JS code)
# Replace with real values in .env.local or CI environment variables.
SECRET_KEY=
APP_BUILD_ONLY_VAR=
