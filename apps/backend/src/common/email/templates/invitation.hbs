<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>{{appName}} — Invitation</title></head>
<body style="font-family:sans-serif;background:#0d0c0b;color:#faf8f5;padding:32px;">
  <h1 style="color:#b8966a;">{{appName}}</h1>
  <p>You have been invited to join {{appName}} as a <strong>{{role}}</strong>.</p>
  <p>Click the button below to set up your account:</p>
  <a href="{{inviteUrl}}" style="display:inline-block;margin-top:16px;padding:12px 24px;background:#b8966a;color:#0d0c0b;text-decoration:none;border-radius:6px;font-weight:bold;">
    Accept Invitation
  </a>
  <p style="color:#888;margin-top:24px;">This invitation expires in 48 hours.</p>
</body>
</html>
