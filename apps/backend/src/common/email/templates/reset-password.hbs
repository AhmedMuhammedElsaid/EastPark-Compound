<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>{{appName}} — Reset Password</title></head>
<body style="font-family:sans-serif;background:#0d0c0b;color:#faf8f5;padding:32px;">
  <h1 style="color:#b8966a;">{{appName}}</h1>
  <p>You requested a password reset. Click the button below to set a new password:</p>
  <a href="{{resetUrl}}" style="display:inline-block;margin-top:16px;padding:12px 24px;background:#b8966a;color:#0d0c0b;text-decoration:none;border-radius:6px;font-weight:bold;">
    Reset Password
  </a>
  <p style="color:#888;margin-top:24px;">This link expires in 30 minutes. If you did not request a reset, ignore this email.</p>
</body>
</html>
