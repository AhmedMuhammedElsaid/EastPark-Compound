<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <meta name="supported-color-schemes" content="dark light">
  <title>{{appName}}</title>
</head>
<body style="margin:0;padding:0;background:#0d0c0b;color:#faf8f5;font-family:Cairo,Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">A secure message from EastPark.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#0d0c0b;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:560px;background:#221f1c;border:1px solid #3d3830;border-radius:12px;overflow:hidden;">
          <tr>
            <td align="center" style="padding:32px 24px 24px;border-bottom:1px solid #3d3830;">
              <img src="cid:eastpark-logo" width="64" height="64" alt="EastPark" style="display:block;width:64px;height:64px;object-fit:contain;margin:0 auto 14px;border:0;">
              <div style="font-family:Georgia,serif;font-size:30px;line-height:36px;color:#faf8f5;letter-spacing:0;">EAST PARK</div>
              <div style="margin-top:6px;font-size:11px;line-height:16px;color:#b8966a;letter-spacing:2px;">INTEGRATED COMMUNITY</div>
            </td>
          </tr>
          <tr>
            <td style="padding:32px 28px;font-size:16px;line-height:26px;color:#faf8f5;">
              {{{content}}}
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px 24px;border-top:1px solid #3d3830;font-size:12px;line-height:20px;color:#a89880;">
              EastPark Integrated Community<br>
              Need help? <a href="mailto:eastpark.eg@gmail.com" style="color:#b8966a;text-decoration:none;">eastpark.eg@gmail.com</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>