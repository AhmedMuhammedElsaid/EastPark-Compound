{
    "name": "eastpark-backend",
    "version": "1.0.0",
    "description": "EastPark App — residential compound super-app backend (NestJS + Fastify + Prisma + PostgreSQL + Redis + Socket.io)",
    "author": "AhmedMuhammedElsaid",
    "license": "MIT",
    "private": true,
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "prepare": "husky",
        "postinstall": "prisma generate",
        "prebuild": "rimraf dist",
        "pretest": "prisma generate",
        "build": "nest build",
        "start": "node dist/main",
        "start:dev": "nest start --watch",
        "start:prod": "cross-env NODE_ENV=production node dist/main",
        "start:debug": "nest start --debug --watch",
        "dev": "nest start --watch",
        "debug": "nest start --debug --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{src,test}/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "jest --config test/jest.json --coverage --runInBand --passWithNoTests --forceExit",
        "test:watch": "jest --config test/jest.json --no-coverage --watch",
        "test:ci": "jest --config test/jest.json --coverage --ci --runInBand --forceExit",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config test/jest.json --runInBand",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate-prod": "prisma migrate deploy",
        "prisma:reset": "prisma migrate reset",
        "prisma:status": "prisma migrate status",
        "prisma:studio": "prisma studio",
        "seed": "ts-node -r tsconfig-paths/register prisma/seed-data.ts",
        "seed:showcase": "ts-node -r tsconfig-paths/register prisma/seed-showcase.ts",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "docker:reset": "docker-compose down -v --remove-orphans",
        "dev:setup": "bash scripts/dev.sh",
        "dev:reset": "bash scripts/reset.sh",
        "ci": "pnpm typecheck && pnpm lint:check && pnpm format:check && pnpm test:ci"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.2",
        "@fastify/helmet": "^13.0.1",
        "@fastify/multipart": "^9.0.3",
        "@fastify/static": "^9.0.0",
        "@nestjs/common": "^11.1.14",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.14",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-fastify": "^11.1.14",
        "@nestjs/platform-socket.io": "^11.1.14",
        "@nestjs/schedule": "^6.1.1",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.14",
        "@prisma/client": "6.19.0",
        "@supabase/supabase-js": "^2.49.9",
        "@upstash/redis": "^1.35.8",
        "argon2": "^0.44.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "date-fns": "^4.1.0",
        "dotenv": "^17.3.1",
        "expo-server-sdk": "^3.15.0",
        "fastify": "5.11.3",
        "handlebars": "^4.7.8",
        "ioredis": "^5.6.1",
        "jsonwebtoken": "^9.0.3",
        "lodash": "^4.17.23",
        "nestjs-pino": "^4.6.0",
        "nodemailer": "^6.10.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "prisma": "6.19.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.4.2",
        "@commitlint/config-conventional": "^20.4.2",
        "@faker-js/faker": "^9.7.0",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/testing": "^11.1.14",
        "@swc/cli": "^0.8.0",
        "@swc/core": "^1.15.11",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.17.23",
        "@types/node": "^25.3.0",
        "@types/nodemailer": "^6.4.17",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.3",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.0.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.15.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-promise": "^7.2.1",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.56.0",
        "ws": "^8.19.0"
    },
    "prisma": {
        "seed": "ts-node -r tsconfig-paths/register prisma/seed-data.ts"
    },
    "lint-staged": {
        "{src,test}/**/*.{ts,js,json}": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "packageManager": "pnpm@9.15.0"
}
