# ==============================================
# EastPark Backend — Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==============================================
# APPLICATION
# ==============================================
APP_ENV="local"            # local | staging | production
APP_NAME="EastPark API"
APP_LOG_LEVEL="debug"

APP_CORS_ORIGINS="*"      # prod: "https://app.eastpark.com"

# ==============================================
# HTTP SERVER
# ==============================================
HTTP_HOST="0.0.0.0"
HTTP_PORT=3000             # Local dev; root render.yaml sets production to 10000

# ==============================================
# AUTHENTICATION & JWT
# Two separate secrets required.
# Generate: openssl rand -base64 48
# ==============================================
AUTH_ACCESS_TOKEN_SECRET="change-me-min-32-chars"
AUTH_REFRESH_TOKEN_SECRET="change-me-different-min-32-chars"
AUTH_ACCESS_TOKEN_EXP="15m"
AUTH_REFRESH_TOKEN_EXP="7d"

# Shared secret between the Vercel web BFF and this API (min 32 chars).
# The BFF sends it as `X-EastPark-Internal` with `X-EastPark-Client-IP: <client ip>`
# so throttling keys on the real browser IP. Other traffic is keyed on
# Cloudflare's `CF-Connecting-IP`. Must match the web app's value exactly, or
# all web users share Vercel-egress buckets. Blank locally is fine.
# Generate: openssl rand -hex 32
BFF_INTERNAL_SECRET=""

# ==============================================
# DOCKER COMPOSE — local service credentials
# Used by docker-compose.yml; also referenced in DATABASE_URL below.
# ==============================================
POSTGRES_PASSWORD=""
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD=""

# ==============================================
# DATABASE (Docker PostgreSQL locally / Supabase in prod)
# Set POSTGRES_PASSWORD above, then paste it into the URL below.
# ==============================================
DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/eastpark?schema=public"

# Migrations only (schema.prisma `directUrl`). Locally there is no connection
# pooler, so this matches DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/eastpark?schema=public"

# ── Production (Supabase) ─────────────────────────────────────────────────
# Copy BOTH from Supabase Dashboard → Connect. They differ only in the port.
#   DATABASE_URL         Transaction pooler, port 6543, + ?pgbouncer=true&connection_limit=1
#   DIRECT_DATABASE_URL  Session pooler,     port 5432, no query params
#
# Use the POOLER host (<region>.pooler.supabase.com), never db.<ref>.supabase.co:
# the direct host is IPv6-only and Fly VMs get no public IPv4 egress, so it is
# unreachable. The pooler resolves to IPv4.
#
# The pooler username embeds the project ref: postgres.<project-ref>
#
# ⚠️ Percent-encode the password. A literal '#' truncates the URL at the fragment
# and a literal '@' splits the authority — either one silently yields a wrong host.
#   #  →  %23      @  →  %40      :  →  %3A      /  →  %2F
#
# DATABASE_URL="postgresql://postgres.<ref>:<url-encoded-pw>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<url-encoded-pw>@<region>.pooler.supabase.com:5432/postgres"

# ==============================================
# REDIS
# Local development uses TCP Redis. Production Render uses Upstash REST.
# When both are configured, the Upstash REST transport takes precedence.
# ==============================================
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================
# EMAIL (Mailpit locally, Brevo SMTP in prod)
# Render free instances block 25/465/587; use Brevo's supported port 2525 there.
# ==============================================
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="EastPark <eastpark.eg@gmail.com>"
EMAIL_REPLY_TO="eastpark.eg@gmail.com"
EMAIL_SUPPORT_TO="eastpark.eg@gmail.com"

# ==============================================
# FILE STORAGE
# Dev: MinIO (docker-compose) → S3-compatible
# Prod: Supabase Storage
# ==============================================
SUPABASE_URL="http://localhost:9002"
SUPABASE_SERVICE_KEY=""              # Dev: set to MINIO_ROOT_PASSWORD value
SUPABASE_BUCKET="eastpark-uploads"

# ==============================================
# PAYMENTS
# Disabled for the first release. Set true only after configuring and
# validating all Paymob credentials below.
# ==============================================
PAYMENTS_ENABLED="false"

# ==============================================
# PAYMENTS — PAYMOB
# ==============================================
# These four MUST be present as keys, even if left empty locally — there is no
# Paymob sandbox for local dev. PaymentsService reads PAYMOB_HMAC_SECRET in its
# CONSTRUCTOR via getOrThrow(), so if the key is absent from .env entirely the
# app will refuse to boot. An empty value is fine; a missing line is not.
# In production these are set via `fly secrets set` and must be real.
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""   # From Paymob dashboard → Integrations → Integration ID
PAYMOB_IFRAME_ID=""        # From Paymob dashboard → Integrations → iframe ID

# ==============================================
# SEED — default dev credentials (local only)
# ==============================================
SEED_ADMIN_EMAIL="admin@eastpark.app"
SEED_ADMIN_PASSWORD=""
SEED_MERCHANT_PASSWORD=""
SEED_RESIDENT_PASSWORD=""

# ==============================================
# APP URLS
# ==============================================
APP_URL="http://localhost:3000"
WEB_APP_URL="http://localhost:3000"
