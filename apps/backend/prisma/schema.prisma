// EastPark App — Prisma Schema
// Residential compound super-app: marketplace + community governance

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase transaction pooler, port 6543 (?pgbouncer=true&connection_limit=1)
  // — runtime queries.
  url       = env("DATABASE_URL")
  // Supabase session pooler, port 5432 — migrations only. The transaction
  // pooler breaks the advisory locks and prepared statements that
  // `prisma migrate deploy` relies on.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  GUEST
  RESIDENT
  MERCHANT
  ADMIN
  SUPER_ADMIN
  ACCOUNTANT
}

enum ShopCategory {
  CAFE_AND_FOOD
  GROCERY
  BUTCHER
  SERVICES
  OTHER
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PAYMOB
}

enum AnnouncementCategory {
  GENERAL
  PROMOTION
  EVENT
  MAINTENANCE
  NEWS
}

enum FeedbackCategory {
  MAINTENANCE
  SECURITY
  CLEANLINESS
  NOISE
  SUGGESTION
  OTHER
}

enum FeedbackStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  ORDER_UPDATE
  ANNOUNCEMENT
  POLL
  ELECTION
  FEEDBACK_UPDATE
  LISTING_UPDATE
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
  RENTED
  WITHDRAWN
  EXPIRED
}

enum ElectionVisibilityMode {
  SEALED_UNTIL_DEADLINE
  LIVE_COUNT
  ADMIN_CONTROLLED
}

enum ResidentLeadStatus {
  PENDING
  INVITED
  CONVERTED
  REJECTED
}

enum MaritalStatus {
  MARRIED
  SINGLE
  DIVORCED
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  unitNumber   String?
  passwordHash String
  role         Role     @default(RESIDENT)
  avatarUrl    String?
  pushToken    String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Soft delete (recycle bin): a deleted account cannot sign in and is hidden
  // everywhere; only the SUPER_ADMIN can restore it.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  shops             Shop[]
  orders            Order[]
  reviews           Review[]
  votes             Vote[]
  feedbacks         Feedback[]
  savedShops        SavedShop[]
  comments          Comment[]
  electionVotes     ElectionVote[]
  feedbackReplies   FeedbackReply[]
  notificationPrefs NotificationPreference[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  invitations       Invitation[]             @relation("InvitedBy")
  residentLeads     ResidentLead[]           @relation("ResidentLeadUser")
  residentUnits     ResidentUnit[]           @relation("ResidentUnitOwner")
  addedUnits        ResidentUnit[]           @relation("ResidentUnitAddedBy")
  listings          Listing[]                @relation("ListingOwner")
  reviewedListings  Listing[]                @relation("ListingReviewer")
  listingRevisions  ListingRevision[]        @relation("ListingRevisionEditor")

  // Finance (accounting Phase 1a). All Restrict: users are soft-deleted.
  flatOwnerships         FlatOwnership[]     @relation("FlatOwnershipOwner")
  openedFlatOwnerships   FlatOwnership[]     @relation("FlatOwnershipOpenedBy")
  closedFlatOwnerships   FlatOwnership[]     @relation("FlatOwnershipClosedBy")
  billingRunsCreated     BillingRun[]        @relation("BillingRunCreatedBy")
  billingRunsCommitted   BillingRun[]        @relation("BillingRunCommittedBy")
  billingRunsVoided      BillingRun[]        @relation("BillingRunVoidedBy")
  chargesCreated         Charge[]            @relation("ChargeCreatedBy")
  chargesVoided          Charge[]            @relation("ChargeVoidedBy")
  paymentsCreated        Payment[]           @relation("PaymentCreatedBy")
  paymentsVoided         Payment[]           @relation("PaymentVoidedBy")
  allocationsCreated     PaymentAllocation[] @relation("AllocationCreatedBy")
  allocationsVoided      PaymentAllocation[] @relation("AllocationVoidedBy")
  fiscalPeriodsClosed    FiscalPeriod[]      @relation("FiscalPeriodClosedBy")
  fiscalPeriodsReopened  FiscalPeriod[]      @relation("FiscalPeriodReopenedBy")
  financeSettingsUpdated FinanceSetting[]    @relation("FinanceSettingUpdatedBy")
  importBatchesCreated   ImportBatch[]       @relation("ImportBatchCreatedBy")
  importBatchesCommitted ImportBatch[]       @relation("ImportBatchCommittedBy")
  importBatchesVoided    ImportBatch[]       @relation("ImportBatchVoidedBy")
  fundEntriesCreated     FundEntry[]         @relation("FundEntryCreatedBy")
  fundEntriesVoided      FundEntry[]         @relation("FundEntryVoidedBy")

  deletedUsers      User[]      @relation("UserDeletedBy")
  deletedShops      Shop[]      @relation("ShopDeletedBy")
  deletedShopPhotos ShopPhoto[] @relation("ShopPhotoDeletedBy")
  deletedProducts   Product[]   @relation("ProductDeletedBy")
  deletedReviews    Review[]    @relation("ReviewDeletedBy")

  @@index([deletedAt])
  @@map("users")
}

model Invitation {
  id        String    @id @default(cuid())
  email     String
  role      Role
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([invitedById])
  @@map("invitations")
}

// ─── Resident Leads ───────────────────────────────────────────────────────────

// WARNING: the partial unique index `resident_leads_active_unit_key` on
// (building, floor, flatNumber) WHERE status IN ('PENDING', 'INVITED') (created by
// `20260930000000_resident_lead_unique_active_unit`, recreated with this WHERE
// clause by `20261007100000_resident_units`) is NOT modelled here: Prisma cannot
// model partial indexes, so `prisma migrate dev` will propose a diff that DROPS
// it. Never accept that diff — the index is the atomic guard for a flat in an
// ACTIVE application (ResidentsService maps its P2002 to HTTP 409). An OWNED flat
// is guarded by `resident_units`' own unique key. Hand-edit the generated SQL to
// remove the DROP INDEX statement instead.
model ResidentLead {
  id             String             @id @default(cuid())
  name           String
  email          String
  phone          String
  building       String
  floor          String
  flatNumber     String
  parking        String?
  jobTitle       String?
  maritalStatus  MaritalStatus?
  nationalId     String?
  passportNumber String?
  status         ResidentLeadStatus @default(PENDING)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  userId String?
  user   User?   @relation("ResidentLeadUser", fields: [userId], references: [id], onDelete: SetNull)

  unit ResidentUnit?

  @@index([status, createdAt])
  @@index([email])
  @@index([building, floor, flatNumber])
  @@index([userId])
  @@map("resident_leads")
}

// A flat owned by an account (multi-flat owners, 2026-10-07). One account can
// own many flats; a flat has at most one owner at a time. Removing a flat (sale
// or transfer) HARD-deletes the row — the audit log keeps the history — and it
// is not part of the recycle bin. Label everywhere: `${building}-${floor}-${flatNumber}`.
// `User.unitNumber` stays the PRIMARY flat label (old mobile builds read it).
model ResidentUnit {
  id         String   @id @default(cuid())
  building   String
  floor      String
  flatNumber String
  createdAt  DateTime @default(now())

  // Users are soft-deleted, never hard-deleted: Restrict, not Cascade.
  userId String
  user   User   @relation("ResidentUnitOwner", fields: [userId], references: [id], onDelete: Restrict)

  // Who added it; null for the backfill and for a self-accepted invitation.
  addedById String?
  addedBy   User?   @relation("ResidentUnitAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  // The registration it came from, if any.
  leadId String?       @unique
  lead   ResidentLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Link to the flat registry (finance). Null while the key is not one of the 690
  // layout keys; the text columns stay the fallback.
  flatId String?
  flat   Flat?   @relation(fields: [flatId], references: [id], onDelete: SetNull)

  @@unique([building, floor, flatNumber])
  @@index([userId])
  @@index([flatId])
  @@map("resident_units")
}

// ─── Flat listings (sell / rent) ──────────────────────────────────────────────

// WARNING: the partial unique index `listings_active_unit_key` on
// (building, floor, flatNumber) WHERE status IN ('PENDING', 'APPROVED') (created by
// `20261031000000_flat_listings`) is NOT modelled here: Prisma cannot model partial
// indexes, so `prisma migrate dev` will propose a diff that DROPS it. Never accept
// that diff — the index is the atomic guard for "at most one active listing per
// flat" (ListingsService maps its P2002 to HTTP 409 `listing.error.unitAlreadyListed`).
// Hand-edit any generated SQL to remove the DROP INDEX statement instead.
// Label everywhere: `${building}-${floor}-${flatNumber}`. Contract:
// Documentation/LISTINGS-CONTRACT.md.
model Listing {
  id           String        @id @default(cuid())
  type         ListingType
  status       ListingStatus @default(PENDING)
  building     String
  floor        String
  flatNumber   String
  price        Decimal       @db.Decimal(12, 2) // SALE = total, RENT = per month (EGP)
  areaSqm      Int
  bedrooms     Int
  bathrooms    Int
  furnished    Boolean
  description  String?
  contactPhone String
  photos       String[] // storage URLs, array order = display order, [0] = cover
  rejectReason String?
  approvedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Users are soft-deleted, never hard-deleted: Restrict, not Cascade.
  ownerId String
  owner   User   @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // The admin who last approved / rejected it.
  reviewedById String?
  reviewedBy   User?   @relation("ListingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Link to the flat registry (finance); null for an unknown key.
  flatId String?
  flat   Flat?   @relation(fields: [flatId], references: [id], onDelete: SetNull)

  revisions ListingRevision[]

  @@index([flatId])
  @@index([status, approvedAt, id])
  @@index([ownerId, createdAt, id])
  @@index([status, expiresAt])
  @@map("listings")
}

// One row per owner edit: `changes` = only the fields that changed, `snapshot` =
// the full previous field values (admin review aid, never shown to residents).
model ListingRevision {
  id        String   @id @default(cuid())
  changes   Json
  snapshot  Json
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  editorId String
  editor   User   @relation("ListingRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt, id])
  @@map("listing_revisions")
}

// ─── Shops & Products ─────────────────────────────────────────────────────────

model Shop {
  id            String       @id @default(cuid())
  name          String
  nameAr        String
  description   String?
  descriptionAr String?
  category      ShopCategory
  workingHours  Json? // { mon: { open: "09:00", close: "22:00", closed: false }, ... }
  isOpen        Boolean      @default(true) // manual emergency override
  phone         String?
  whatsapp      String?
  deliveryTime  Int? // estimated minutes
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  merchantId String
  merchant   User   @relation(fields: [merchantId], references: [id])

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ShopDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  photos   ShopPhoto[]
  products Product[]
  orders   Order[]
  reviews  Review[]
  savedBy  SavedShop[]

  @@index([merchantId])
  @@index([category, createdAt])
  @@index([deletedAt])
  @@map("shops")
}

model ShopPhoto {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ShopPhotoDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([shopId, order])
  @@index([deletedAt])
  @@map("shop_photos")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  nameAr        String
  description   String?
  descriptionAr String?
  price         Decimal  @db.Decimal(10, 2)
  imageUrl      String?
  isAvailable   Boolean  @default(true)
  isDeleted     Boolean  @default(false) // soft delete — preserves OrderItem FK
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  // Kept in sync with isDeleted (which every product read filters on).
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ProductDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([shopId, isDeleted, createdAt])
  @@index([deletedAt])
  @@map("products")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id            String        @id @default(cuid())
  status        OrderStatus   @default(PLACED)
  totalAmount   Decimal       @db.Decimal(10, 2) // computed server-side — never trust client
  notes         String? // free-text delivery notes (no time slots)
  deliveryUnit  String // pre-filled from resident profile
  paymentMethod PaymentMethod @default(CASH)
  isPaid        Boolean       @default(false)
  paymobOrderId String? // Paymob ORDER id registered at payment initiation (not the transaction id)
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  residentId String
  resident   User   @relation(fields: [residentId], references: [id])
  shopId     String
  shop       Shop   @relation(fields: [shopId], references: [id])

  items OrderItem[]

  @@index([residentId, createdAt])
  @@index([shopId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                    String  @id @default(cuid())
  quantity              Int
  unitPrice             Decimal @db.Decimal(10, 2)
  productNameSnapshot   String // safe receipt — product name at time of order
  productNameArSnapshot String

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── Reviews & Saved ──────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ReviewDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([userId, shopId])
  @@index([shopId, createdAt])
  @@index([deletedAt])
  @@map("reviews")
}

model SavedShop {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@id([userId, shopId])
  @@map("saved_shops")
}

// ─── Community Hub ────────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  title       String
  titleAr     String
  body        String
  bodyAr      String
  category    AnnouncementCategory @default(GENERAL)
  pdfUrl      String?
  publishedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  comments Comment[]

  @@map("announcements")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id])
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
  @@map("comments")
}

model Report {
  id          String   @id @default(cuid())
  title       String
  titleAr     String
  pdfUrl      String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("reports")
}

// ─── Governance ───────────────────────────────────────────────────────────────

model Poll {
  id         String   @id @default(cuid())
  question   String
  questionAr String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  options PollOption[]
  votes   Vote[]

  @@map("polls")
}

model PollOption {
  id      String @id @default(cuid())
  label   String
  labelAr String

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  Vote[]

  @@map("poll_options")
}

model Vote {
  createdAt DateTime @default(now())

  userId   String
  user     User       @relation(fields: [userId], references: [id])
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id])
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id])

  @@id([userId, pollId])
  @@index([pollId])
  @@map("votes")
}

model Election {
  id             String                 @id @default(cuid())
  title          String
  titleAr        String
  description    String?
  descriptionAr  String?
  expiresAt      DateTime
  resultsOpen    Boolean                @default(false) // flipped by @Cron every 5min when expiresAt passed
  visibilityMode ElectionVisibilityMode @default(SEALED_UNTIL_DEADLINE)
  createdAt      DateTime               @default(now())

  candidates Candidate[]
  votes      ElectionVote[]

  @@index([expiresAt, resultsOpen])
  @@map("elections")
}

model Candidate {
  id          String  @id @default(cuid())
  name        String
  nameAr      String
  statement   String?
  statementAr String?
  photoUrl    String?

  electionId String
  election   Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votes      ElectionVote[]

  @@index([electionId])
  @@map("candidates")
}

model ElectionVote {
  createdAt DateTime @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id])
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id])
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@id([userId, electionId])
  @@index([electionId])
  @@map("election_votes")
}

// ─── Feedback & Complaints ────────────────────────────────────────────────────

model Feedback {
  id          String           @id @default(cuid())
  category    FeedbackCategory
  body        String
  isAnonymous Boolean          @default(false)
  status      FeedbackStatus   @default(SUBMITTED)
  attachments String[] // Supabase Storage URLs (max 3)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userId  String
  user    User            @relation(fields: [userId], references: [id])
  replies FeedbackReply[]

  @@index([userId, createdAt])
  @@index([category])
  @@index([status])
  @@map("feedbacks")
}

model FeedbackReply {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id]) // admin who replied

  @@index([feedbackId, createdAt])
  @@map("feedback_replies")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model NotificationPreference {
  enabled Boolean @default(true)

  userId String
  user   User             @relation(fields: [userId], references: [id])
  type   NotificationType

  @@id([userId, type])
  @@map("notification_preferences")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  titleAr   String
  body      String
  bodyAr    String
  data      Json? // deep-link payload
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. "CREATE_POLL", "UPDATE_ORDER_STATUS"
  entity    String // e.g. "Poll", "Order"
  entityId  String?
  meta      Json? // extra context
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt, id])
  @@map("audit_logs")
}

// ─── Finance (accounting Phase 1a: foundations) ───────────────────────────────
// Plan: Documentation/ACCOUNTING-PLAN.md section 2.4. Migration
// `20261102000000_finance_foundations`. Every table has RLS enabled and no policy
// (the backend uses the owner connection). Money is Decimal(12,2) with a CHECK
// (amount > 0) added in the migration (Prisma cannot model CHECK constraints).
// Dates that are accounting dates (fromDate, receivedAt, dueDate, ...) are DATE
// columns; they are Cairo calendar days, never UTC instants.
// No Cascade anywhere in the finance tables: nothing disappears silently.

enum ChargeKind {
  SERVICE_CHARGE
  MAINTENANCE_DEPOSIT
  SHORTFALL
  SERVICE_FEE
  OPENING_BALANCE
  OTHER
}

enum PostingStatus {
  POSTED
  VOID
}

// The existing PaymentMethod enum is orders-only.
enum FinancePaymentMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  CHEQUE
}

enum ChequeState {
  NOT_APPLICABLE
  PENDING_CLEARANCE
  CLEARED
  BOUNCED
}

enum ImportBatchStatus {
  PREVIEW
  COMMITTED
  VOIDED
  DISCARDED
}

enum ImportRowAction {
  CREATE
  SKIP
}

enum EntryDirection {
  IN
  OUT
}

enum FundEntryKind {
  DEPOSIT_IN
  INVESTMENT_INCOME
  MAINTENANCE_OUT
  ADJUSTMENT
  OPENING_BALANCE
}

enum FundHolding {
  CASH
  INVESTED
}

enum OwnershipClosedReason {
  SOLD
  REMOVED
  ACCOUNT_DELETED
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum BillingRunKind {
  SERVICE_CHARGE
  SHORTFALL
  CUSTOM
}

enum BillingRunStatus {
  PREVIEW
  COMMITTED
  VOID
}

enum FinanceCategoryType {
  REVENUE
  EXPENSE
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_OFF
}

// One row per physical flat, seeded by the migration from the compound layout
// (690 keys, src/common/finance/compound-layout.ts). `ResidentUnit` only exists
// while an account owns the flat; Flat exists always. `label` = `A1-3-2`.
model Flat {
  id          String   @id @default(cuid())
  building    String
  floor       String
  flatNumber  String
  label       String   @unique
  phase       String
  isActive    Boolean  @default(true)
  shareWeight Decimal  @default(1) @db.Decimal(8, 4) // reserved for area-based billing, v1 always 1
  createdAt   DateTime @default(now())

  ownerships    FlatOwnership[]
  residentUnits ResidentUnit[]
  listings      Listing[]
  charges       Charge[]
  payments      Payment[]
  importRows    ImportRow[]

  @@unique([building, floor, flatNumber])
  @@index([phase])
  @@index([building])
  @@map("flats")
}

// WARNING: the partial unique index `flat_ownership_one_open` on (flatId) WHERE
// "toDate" IS NULL (created by `20261102000000_finance_foundations`) is NOT
// modelled here: Prisma cannot model partial indexes, so `prisma migrate dev` will
// propose a diff that DROPS it. Never accept that diff — the index is the atomic
// guard for "at most one open ownership period per flat". Hand-edit any generated
// SQL to remove the DROP INDEX statement instead.
// `fromDate = 1900-01-01` means "owned since before finance go-live" (cut-over
// backfill); every period opened afterwards uses the real Cairo transaction date.
model FlatOwnership {
  id           String                 @id @default(cuid())
  fromDate     DateTime               @db.Date
  toDate       DateTime?              @db.Date // null = current owner
  closedReason OwnershipClosedReason?
  createdAt    DateTime               @default(now())

  flatId String
  flat   Flat   @relation(fields: [flatId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("FlatOwnershipOwner", fields: [userId], references: [id], onDelete: Restrict)

  openedById String?
  openedBy   User?   @relation("FlatOwnershipOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)

  closedById String?
  closedBy   User?   @relation("FlatOwnershipClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([flatId, toDate])
  @@index([userId])
  @@map("flat_ownerships")
}

model FinanceCategory {
  id        String              @id @default(cuid())
  name      String
  nameAr    String
  type      FinanceCategoryType
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  isSystem  Boolean             @default(false) // seeded rows cannot be deleted, only hidden
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  feeSchedules FeeSchedule[]

  @@unique([type, name])
  @@map("finance_categories")
}

model FeeSchedule {
  id        String       @id @default(cuid())
  name      String
  nameAr    String
  kind      ChargeKind // SERVICE_CHARGE or SERVICE_FEE
  amount    Decimal      @db.Decimal(12, 2) // default per flat
  frequency FeeFrequency
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  categoryId String
  category   FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  billingRuns BillingRun[]

  @@index([categoryId])
  @@map("fee_schedules")
}

// WARNING: the partial unique index `billing_runs_period_key` on (periodKey)
// WHERE status = 'COMMITTED' AND "periodKey" IS NOT NULL (created by
// `20261102000000_finance_foundations`) is NOT modelled here: Prisma cannot model
// partial indexes, so `prisma migrate dev` will propose a diff that DROPS it.
// Never accept that diff — the index is the "one committed billing per period"
// guard (SC:<feeScheduleId>:<period>, SF:<period>). Hand-edit any generated SQL
// to remove the DROP INDEX statement instead.
model BillingRun {
  id            String           @id @default(cuid())
  kind          BillingRunKind
  period        String // YYYY-MM, YYYY-Qn or YYYY
  accrualPeriod String // YYYY-MM the run books into
  description   String
  descriptionAr String
  amount        Decimal          @db.Decimal(12, 2)
  dueDate       DateTime         @db.Date
  status        BillingRunStatus @default(PREVIEW)
  requestKey    String           @unique
  requestHash   String
  periodKey     String? // "billed once" key; null for CUSTOM
  params        Json
  committedAt   DateTime?
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime         @default(now())

  feeScheduleId String?
  feeSchedule   FeeSchedule? @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("BillingRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  committedById String?
  committedBy   User?   @relation("BillingRunCommittedBy", fields: [committedById], references: [id], onDelete: Restrict)

  voidedById String?
  voidedBy   User?   @relation("BillingRunVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  charges Charge[]

  @@index([status])
  @@index([accrualPeriod])
  @@index([feeScheduleId])
  @@map("billing_runs")
}

// A bulk run charges each flat once: `@@unique([billingRunId, flatId])`. A posted
// charge is never edited except status / void fields; a correction is a new row
// pointing at the voided original through `replacesId`.
// `serviceSaleId` arrives with the Phase 2 migration (`finance_ledgers`).
model Charge {
  id               String        @id @default(cuid())
  kind             ChargeKind
  amount           Decimal       @db.Decimal(12, 2) // CHECK (amount > 0) in the migration
  description      String
  descriptionAr    String
  accrualPeriod    String // YYYY-MM
  dueDate          DateTime      @db.Date
  status           PostingStatus @default(POSTED)
  fundContribution Boolean       @default(false) // true when kind = MAINTENANCE_DEPOSIT
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime      @default(now())

  flatId String
  flat   Flat   @relation(fields: [flatId], references: [id], onDelete: Restrict)

  billingRunId String?
  billingRun   BillingRun? @relation(fields: [billingRunId], references: [id], onDelete: Restrict)

  replacesId String?
  replaces   Charge?  @relation("ChargeReplaces", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy Charge[] @relation("ChargeReplaces")

  voidedById String?
  voidedBy   User?   @relation("ChargeVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("ChargeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  @@unique([billingRunId, flatId])
  @@index([flatId, status])
  @@index([accrualPeriod])
  @@index([dueDate])
  @@index([replacesId])
  @@map("charges")
}

// Money received from or on behalf of a flat. `requestKey` is the idempotency key
// stored on the row (survives a Redis flush). `(method, reference)` is a plain
// index for the soft duplicate-reference warning, NOT unique.
// The `finance_live_payments` view (migration, not modelled) reads this table.
model Payment {
  id             String               @id @default(cuid())
  receiptNo      String               @unique // R-2026-000123, O- for opening rows
  amount         Decimal              @db.Decimal(12, 2) // CHECK (amount > 0) in the migration
  method         FinancePaymentMethod
  requestKey     String               @unique
  requestHash    String
  reference      String?
  chequeState    ChequeState          @default(NOT_APPLICABLE)
  clearedAt      DateTime?            @db.Date
  bouncedAt      DateTime?            @db.Date
  receivedAt     DateTime             @db.Date // cash date; the period lock applies to it
  payerName      String?
  note           String?
  status         PostingStatus        @default(POSTED)
  attachmentPath String? // private bucket path
  isOpening      Boolean              @default(false)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime             @default(now())

  flatId String
  flat   Flat   @relation(fields: [flatId], references: [id], onDelete: Restrict)

  replacesId String?
  replaces   Payment?  @relation("PaymentReplaces", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy Payment[] @relation("PaymentReplaces")

  voidedById String?
  voidedBy   User?   @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]
  fundEntries FundEntry[]

  @@index([flatId, status])
  @@index([flatId, chequeState])
  @@index([receivedAt])
  @@index([method, reference])
  @@index([replacesId])
  @@map("payments")
}

model PaymentAllocation {
  id          String    @id @default(cuid())
  amount      Decimal   @db.Decimal(12, 2) // CHECK (amount > 0) in the migration
  allocatedAt DateTime  @db.Date // accounting date of the allocation
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime  @default(now())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  chargeId String
  charge   Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  voidedById String?
  voidedBy   User?   @relation("AllocationVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("AllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

// Gap-free numbering per scope (R / O / E / V / F) and year: incremented inside
// the posting transaction with INSERT ... ON CONFLICT DO UPDATE.
model ReceiptCounter {
  scope String
  year  Int
  last  Int    @default(0)

  @@id([scope, year])
  @@map("receipt_counters")
}

// A missing row means OPEN for reads; every posting upserts the row then locks it
// FOR SHARE, close takes it FOR UPDATE (plan 3.2).
model FiscalPeriod {
  period       String       @id // YYYY-MM
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?
  reopenedAt   DateTime?
  reopenReason String?

  closedById   String?
  closedBy     User?   @relation("FiscalPeriodClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedById String?
  reopenedBy   User?   @relation("FiscalPeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@map("fiscal_periods")
}

// Key / value settings, audited on write. Seeded: expense.approvalThreshold,
// fiscal.yearStartMonth, billing.defaultDueDay.
model FinanceSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("FinanceSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("finance_settings")
}

// WARNING: the partial unique index `import_batches_committed_file_hash_key` on
// ("fileHash") WHERE status = 'COMMITTED' (created by
// `20261102000000_finance_foundations`) is NOT modelled here: Prisma cannot model
// partial indexes, so `prisma migrate dev` will propose a diff that DROPS it.
// Never accept that diff — the index stops the same opening-balance file being
// committed twice. Hand-edit any generated SQL to remove the DROP INDEX
// statement instead.
model ImportBatch {
  id          String            @id @default(cuid())
  fileHash    String // sha256 of the uploaded file
  status      ImportBatchStatus @default(PREVIEW)
  asOf        DateTime          @db.Date
  totalRows   Int               @default(0)
  okRows      Int               @default(0)
  warningRows Int               @default(0)
  errorRows   Int               @default(0)
  committedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime          @default(now())

  createdById String
  createdBy   User   @relation("ImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  committedById String?
  committedBy   User?   @relation("ImportBatchCommittedBy", fields: [committedById], references: [id], onDelete: Restrict)

  voidedById String?
  voidedBy   User?   @relation("ImportBatchVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  rows ImportRow[]

  @@index([fileHash])
  @@index([status])
  @@map("import_batches")
}

// WARNING: the partial unique index `import_rows_committed_flat_key` on ("flatId")
// WHERE committed = true (created by `20261102000000_finance_foundations`) is NOT
// modelled here: Prisma cannot model partial indexes, so `prisma migrate dev` will
// propose a diff that DROPS it. Never accept that diff — the index lets a flat be
// imported only once, whatever its values are. Voiding a batch sets
// committed = false, which frees the flat. Hand-edit any generated SQL to remove
// the DROP INDEX statement instead.
model ImportRow {
  id        String          @id @default(cuid())
  lineNo    Int
  raw       String
  parsed    Json
  errors    Json
  action    ImportRowAction
  committed Boolean         @default(false)
  createdAt DateTime        @default(now())

  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  flatId String?
  flat   Flat?   @relation(fields: [flatId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([flatId])
  @@map("import_rows")
}

// The maintenance fund. Automatic rows (DEPOSIT_IN, MAINTENANCE_OUT) take
// `requestKey = '<paymentId or expenseId>:<allocationId or approval>'` so a replayed
// transaction cannot create them twice. `expenseId` arrives with the Phase 2
// migration (`finance_ledgers`). `countsInFundTotal = false` only for the per-flat
// DEPOSIT_IN rows written by the opening import.
model FundEntry {
  id                String         @id @default(cuid())
  entryNo           String         @unique // F-2026-000007
  requestKey        String         @unique
  requestHash       String
  kind              FundEntryKind
  holding           FundHolding    @default(CASH)
  countsInFundTotal Boolean        @default(true)
  direction         EntryDirection
  amount            Decimal        @db.Decimal(12, 2) // CHECK (amount > 0) in the migration
  entryDate         DateTime       @db.Date
  investmentRef     String?
  description       String
  status            PostingStatus  @default(POSTED)
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime       @default(now())

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  voidedById String?
  voidedBy   User?   @relation("FundEntryVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("FundEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([entryDate])
  @@index([kind, status])
  @@index([paymentId])
  @@map("fund_entries")
}
